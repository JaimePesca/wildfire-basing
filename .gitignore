# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets: never commit a real FIRMS_MAP_KEY or any other credential.
.env

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Data: real FIRMS/UNGRD/IGAC data must never be committed here, only .gitkeep
# placeholders track the folder structure (see CLAUDE.md section 7).
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Results are generated artifacts, not source; keep the folder tracked
results/*
!results/.gitkeep

# Solver logs (Gurobi writes gurobi.log in the working directory)
gurobi.log
*.log

# LaTeX build artifacts (paper/main.pdf and figures ARE tracked, they
# are the deliverable; only intermediate files are ignored)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.out
paper/*.toc
